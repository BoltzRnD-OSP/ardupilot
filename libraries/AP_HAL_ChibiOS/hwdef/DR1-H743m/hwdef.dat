# hw definition file for processing by chibios_hwdef.py for CUAV-X7

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# crystal frequency
OSCILLATOR_HZ 25000000

# board ID for firmware load
APJ_BOARD_ID 1051

FLASH_SIZE_KB 2048

# with 2M flash we can afford to optimize for speed
#env OPTIMIZE -O2

# ChibiOS system timer
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# bootloader takes first sector
FLASH_RESERVE_START_KB 128

# order of UARTs (and USB)
SERIAL_ORDER OTG1 USART2 USART1 UART7 USART3 # USART1

# default the 2nd interface to MAVLink2 until MissionPlanner updates drivers
#define HAL_OTG2_PROTOCOL SerialProtocol_MAVLink2

# now we define the pins that USB is connected on
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# Port switching for USB HS and FS,high = USB_FS , LOW = USB_HS
#PH15 USB_HS_ENABLE OUTPUT HIGH
#define USB_HW_ENABLE_HS 0

# these are the pins for SWD debugging with a STlinkv2 or black-magic probe
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# SPI1 - internal sensors
# ICM42688p + MS5611
PB3 SPI1_SCK SPI1 PULLUP
PB4 SPI1_MISO SPI1 PULLUP
PB5 SPI1_MOSI SPI1 PULLUP

## SPI2 - FRAM
PB13 SPI2_SCK SPI2 PULLUP
PB14 SPI2_MISO SPI2 PULLUP
PB15 SPI2_MOSI SPI2 PULLUP

# SPI4 - external1 + icm20948
PE2 SPI4_SCK SPI4 PULLUP
PE5 SPI4_MISO SPI4 PULLUP
PE6 SPI4_MOSI SPI4 PULLUP

# sensor 

PB2  ICM42688_CS CS PULLUP
PB1  ICM20948_CS CS PULLUP
PB0  MS5611_BOARD_CS CS PULLUP
PA4  EXT1_CS1 CS PULLUP

PB12 FRAM_CS CS SPEED_VERYLOW NODMA

# I2C buses

# # I2C1 is on GPS port
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1

# I2C4 is on JST-GH
PD12 I2C4_SCL I2C4
PD13 I2C4_SDA I2C4

# order of I2C buses
I2C_ORDER I2C4 I2C1

# drdy pins
PE12  DRDY1_ICM42688 INPUT
#PE13  DRDY2_ICM20948 INPUT
PC2   DRDY_IST8310 INPUT
PE15 INT_ICP20100 INPUT

# USART2 is telem1
PD6 USART2_RX USART2 PULLUP
PD5 USART2_TX USART2 PULLUP
PD3 USART2_CTS USART2 PULLUP
PD4 USART2_RTS USART2 PULLUP

## USART1 is GPS1
PB7 USART1_RX USART1 NODMA
PB6 USART1_TX USART1 NODMA

## USART7 is telem2
PE7 UART7_RX UART7 PULLUP
PE8 UART7_TX UART7 PULLUP
PE10 UART7_CTS UART7 PULLUP
PE9 UART7_RTS UART7 PULLUP

# SBUS, DSM port
PE0 UART8_RX UART8
PE1 UART8_TX UART8

# USART3 is Debug UART
PD8 USART3_TX USART3
PD9 USART3_RX USART3

# RC input
PA10 TIM1_CH3 TIM1 RCININT PULLDOWN LOW

# PWM AUX channels

PA0 TIM5_CH1 TIM5 PWM(1) GPIO(0)
PA1 TIM5_CH2 TIM5 PWM(2) GPIO(1)
PA2 TIM5_CH3 TIM5 PWM(3) GPIO(2)
PA3 TIM5_CH4 TIM5 PWM(4) GPIO(3)
PA5 TIM2_CH1 TIM2 PWM(5) GPIO(4)
PA6 TIM3_CH1 TIM3 PWM(6) GPIO(5)
PA7 TIM3_CH2 TIM3 PWM(7) GPIO(6)
PB10 TIM2_CH3 TIM2 PWM(8) GPIO(7)

PC5 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC4 BATT_CURRENT_SENS ADC1 SCALE(1)

# Now setup the default battery pins driver analog pins and default
# scaling for the power brick.
define HAL_BATT_VOLT_PIN 10
define HAL_BATT_CURR_PIN 11
define HAL_BATT_VOLT_SCALE 11.1
define HAL_BATT_CURR_SCALE 0
define HAL_BATT_MONITOR_DEFAULT 4

# allow for 14 PWMs by default

# PWM output for buzzer
PB11 TIM2_CH4 TIM2 GPIO(77) ALARM

# Safety Switch Input
PA15 SAFETY_IN INPUT PULLDOWN
define HAL_HAVE_SAFETY_SWITCH 1

PC0 RSSI_IN ADC1 SCALE(1)

# CAN bus
PD1 CAN1_TX CAN1
PD0  CAN1_RX CAN1

# control for silent (no output) for CAN
PD11 GPIO_CAN1_SILENT OUTPUT PUSHPULL SPEED_LOW LOW GPIO(70)

# IST8310 reset pin
PC1 GPIO_IST_RST OUTPUT PUSHPULL SPEED_LOW HIGH GPIO(71)

# GPIOs

PD7  VDD_BRICK_nVALID INPUT PULLUP # for PowerC (CAN), considered primary power

# SPI devices
SPIDEV icm42688       SPI1 DEVID1  ICM42688_CS     MODE3  2*MHZ  8*MHZ
SPIDEV icm20948       SPI4 DEVID2  ICM20948_CS     MODE3  2*MHZ  4*MHZ
SPIDEV ms5611         SPI1 DEVID3  MS5611_BOARD_CS MODE3  2*MHZ 8*MHZ
SPIDEV ramtron        SPI2 DEVID4  FRAM_CS         MODE3  8*MHZ  8*MHZ

# three IMUs, only one of ICM20689 and ADIS16470 will be included
IMU Invensensev3 SPI:icm42688 ROTATION_ROLL_180_YAW_90
IMU Invensensev2 SPI:icm20948 ROTATION_NONE

define HAL_DEFAULT_INS_FAST_SAMPLE 1

#—- internal compass that sits inside the ICM-20948
COMPASS AK09916:probe_ICM20948 0 ROTATION_YAW_270   # adjust ROTATION_* to match your PCB

#—- (optional) still probe the external I2C busses for other compasses
define HAL_PROBE_EXTERNAL_I2C_COMPASSES

BARO MS56XX SPI:ms5611
BARO ICP201XX I2C:0:0x64

define HAL_BARO_ALLOW_INIT_NO_BARO

# define HAL_DEFAULT_INS_FAST_SAMPLE 7

# microSD support
PC8 SDMMC1_D0 SDMMC1
PC9 SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2 SDMMC1_CMD SDMMC1

# red LED marked as B/E

PD15 LED_R1 OUTPUT OPENDRAIN HIGH GPIO(8)
PD14 LED_G1 OUTPUT OPENDRAIN HIGH  GPIO(9)
PC6 LED_B1 OUTPUT OPENDRAIN HIGH GPIO(10)

define AP_NOTIFY_GPIO_LED_RGB_RED_PIN 8
define AP_NOTIFY_GPIO_LED_RGB_GREEN_PIN 9
define AP_NOTIFY_GPIO_LED_RGB_BLUE_PIN 10

# use pixracer style 3-LED indicators
define AP_NOTIFY_GPIO_LED_RGB_ENABLED 1

# enable RAMTROM parameter storage
define HAL_STORAGE_SIZE 16384
define STORAGE_FLASH_PAGE 14

# enable FAT filesystem support (needs a microSD defined via SDMMC)
define HAL_OS_FATFS_IO 1

define HAL_BOARD_LOG_DIRECTORY "/APM/LOGS"
define HAL_BOARD_TERRAIN_DIRECTORY "/APM/TERRAIN"

DMA_NOSHARE SPI1*
